{
	"name": "rr7-better-auth",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "rimraf .react-router",
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"stop": "./scripts/stop-servers.sh",
		"typecheck": "react-router typegen && tsc",
		"format": "biome format --write",
		"lint": "biome lint",
		"lint-fix": "biome lint --write",
		"check": "biome check --write",
		"prepare": "# lefthook install",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d",
		"db:logs": "docker compose logs -f postgres",
		"db:connect": "docker compose exec postgres psql -U better_auth -d better_auth",
		"db:generate": "pnpm dlx @better-auth/cli@latest generate --config ./lib/auth.ts",
		"db:migrate": "pnpm dlx @better-auth/cli@latest migrate --config ./lib/auth.ts",
		"setup": "pnpm install && pnpm db:up && pnpm db:generate && pnpm db:migrate"
	},
	"dependencies": {
		"@react-router/node": "7.9.2",
		"@react-router/serve": "7.9.2",
		"better-auth": "1.3.27",
		"isbot": "5.1.31",
		"pg": "8.12.0",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"react-router": "7.9.2"
	},
	"devDependencies": {
		"@react-router/dev": "7.9.2",
		"@tailwindcss/vite": "4.1.13",
		"@types/node": "22",
		"@types/pg": "8.11.10",
		"@types/react": "19.1.13",
		"@types/react-dom": "19.1.9",
		"rimraf": "6.0.1",
		"tailwindcss": "4.1.13",
		"typescript": "5.9.2",
		"vite": "7.1.7",
		"vite-tsconfig-paths": "5.1.4"
	},
	"engines": {
		"node": "24.x"
	}
}
